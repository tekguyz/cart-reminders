# Copy to .env.local. Never commit real values.
# Local work before keys exist: SHOP_MODE=fake (refused on Vercel production).
SHOP_MODE=
BRAND=coquimba
SITE_URL=

# Shopify Partner development store
SHOPIFY_STORE_DOMAIN=          # coquimba-demo.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Admin API: either a fixed token, or the Dev Dashboard app's client credentials
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Stripe, test mode only (the demo refuses live keys)
STRIPE_SECRET_KEY=             # sk_test_...
STRIPE_WEBHOOK_SECRET=         # whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_test_...

# Random strings (openssl rand -hex 32)
REMINDER_LINK_SECRET=
CRON_SECRET=
